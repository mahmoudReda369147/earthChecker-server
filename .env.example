# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://test:<db_password>@quality-db.85hmh9k.mongodb.net/earth-checker?appName=quality-db

# ── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_another_64_byte_hex_secret

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Gmail (password reset emails) ───────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to: Google Account → Security → App Passwords
# 3. Generate a 16-character app password (select "Mail" + device)
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
